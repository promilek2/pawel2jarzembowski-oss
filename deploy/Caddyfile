{
	servers {
		# Ochrona przed slowloris i zbyt dużymi nagłówkami
		timeouts {
			read_header 10s
			read_body 15s
			write 60s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$DOMAIN} {
	encode zstd gzip
	# Bez logów dostępowych: zawierałyby IP i parametry wyszukiwań (PRIVACY.md).
	log {
		output discard
	}
	request_body {
		max_size 64KB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy termin:8000 {
		# zdrowie backendu: przy awarii Caddy szybko zwraca błąd zamiast trzymać połączenia
		health_uri /healthz
		health_interval 30s
		transport http {
			dial_timeout 5s
			response_header_timeout 75s
		}
	}
}
