# Skopiuj do .env i uzupełnij. Wszystkie opcje: termin/config.py (prefiks TERMIN_).
TERMIN_PUBLIC_URL=https://termin.example.org
# TERMIN_TELEGRAM_TOKEN=123456:ABC...
# TERMIN_NTFY_SERVER=https://ntfy.sh
# TERMIN_SMTP_HOST=smtp.example.org
# TERMIN_SMTP_FROM=termin@example.org
# TERMIN_SMTP_USER=
# TERMIN_SMTP_PASSWORD=
# TERMIN_OSRM_URL=https://router.project-osrm.org
# TERMIN_NOMINATIM_URL=https://nominatim.openstreetmap.org
# TERMIN_RATE_LIMIT=30/minute

# --- Bezpieczeństwo (docs/SECURITY_REVIEW.md) ---
# TERMIN_ALLOWED_HOSTS=["termin.example.org"]
# TERMIN_GLOBAL_REQUESTS_PER_MINUTE=300
# TERMIN_MAX_CONCURRENT_SEARCHES=8
# TERMIN_MAILS_PER_ADDRESS_PER_HOUR=3
# Compose: adres, na którym wystawiamy port 8000. Zostaw 127.0.0.1, z internetu przez Caddy.
# TERMIN_BIND=127.0.0.1
# TERMIN_TRACKED_QUERIES=["REZONANS@07","PORADNIA OKULISTYCZNA@11"]

# --- Pomocnik „Jak to działa?” (ADR-0014). Bez klucza odpowiada z wbudowanej pomocy. ---
# TERMIN_AI_API_KEY=sk-ant-...            # klucz z https://console.anthropic.com
# TERMIN_AI_MODEL=claude-opus-5-5          # tańszy: claude-haiku-5-5
# TERMIN_AI_DAILY_LIMIT=200
# TERMIN_AI_RATE_LIMIT=6/minute;40/day
# TERMIN_AI_ENABLED=true

# --- Dane usługodawcy (WYMAGANE przed publicznym uruchomieniem: regulamin, RODO) ---
TERMIN_OPERATOR_NAME=Imię Nazwisko albo nazwa firmy
TERMIN_OPERATOR_ADDRESS=ul. Przykładowa 1, 00-000 Miasto
TERMIN_OPERATOR_EMAIL=kontakt@example.org
# TERMIN_OPERATOR_ID=NIP 0000000000
# TERMIN_DPO_EMAIL=iod@example.org
# TERMIN_SECURITY_CONTACT=security@example.org
# TERMIN_HOSTING_PROVIDER=Nazwa dostawcy serwera
# TERMIN_LEGAL_EFFECTIVE_DATE=2026-10-25
# TERMIN_ACCOUNTS_ENABLED=true
